{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Backend types: type-only Eden imports reach into ../backend/src/app.ts.
       Transpile belongs to Vite; checking the backend is the backend's tsconfig job.
       paths steer elysia/eden type resolution to the backend's copies so `App`
       (backend's elysia) and the treaty client (eden) share one type identity —
       two physical installs would be incompatible despite identical versions. */
    "paths": {
      "elysia": ["../backend/node_modules/elysia"],
      "@elysiajs/eden": ["../backend/node_modules/@elysiajs/eden"],
      "@elysiajs/eden/*": ["../backend/node_modules/@elysiajs/eden/*"],
      "better-auth": ["../backend/node_modules/better-auth"],
      "better-auth/*": ["../backend/node_modules/better-auth/*"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
